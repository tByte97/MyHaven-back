# Скопіюйте у .env і заповніть. .env не комітиться.
# Новий ключ: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_TIME_ZONE=UTC

DB_NAME=MyHaven
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Спільний секрет із Telegram-ботом; те саме значення — MYHAVEN_BOT_API_SECRET у боті.
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_API_SECRET=

# Максимальний розмір файлу виписки в байтах (за замовчуванням 10 МБ).
STATEMENT_MAX_UPLOAD_SIZE=10485760

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
